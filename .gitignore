# Raw sources (PII protection)
/raw/

# Wiki content (사용자 ingest 산출물 — 개인 자료, 공개 리포에 노출 금지)
# root anchor (/wiki/) — `wikey-core/src/wiki/` 같은 nested code 폴더 false-match 방지 (codex cycle #3 Finding 1)
/wiki/

# .wikey/ vault state — 사용자 vault 별 dynamic, git 충돌 방지
# source-registry.json 은 historic tracked → 유지. 나머지 ignore.
.wikey/mention-history.json
.wikey/suggestions.json
.wikey/converged-decompositions.json
.wikey/converged-decompositions.mock-baseline.json
.wikey/qmd-embeddings.json
# (converged-decompositions.json 도 사용자 vault dynamic state — git 충돌 방지)
.wikey/self-declarations.json
.wikey/schema.yaml
.wikey/manual-overrides.yaml
.wikey/.migration-backup-*
.wikey/mention-guard-*.jsonl
# §5.20 query log (vault-local, privacy — never committed)
.wikey/query-log*.jsonl

# Obsidian Web Clipper 기본 저장 폴더 — 개인 수집 자료, 공개 리포에 노출 금지
Clippings/

# Obsidian (UI 상태 — 사용자마다 다름)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/graph.json

# Local LLM models
local-llm/*.gguf
local-llm/*.bin

# API keys / secrets (§5.6.6 — wikey.conf 안 OAuth client_secret 평문 저장 가능)
.env
wikey.conf

# OS
.DS_Store
Thumbs.db

# Temp
/tmp/
*.tmp

# Python
__pycache__/
*.pyc

# Tools — qmd (source clone, node_modules excluded)
tools/qmd/node_modules/

# Node.js
node_modules/

# wikey-core build output + coverage
wikey-core/dist/
wikey-core/coverage/

# wikey-obsidian build output
wikey-obsidian/main.js
wikey-obsidian/kiwi-wasm.wasm

# Obsidian plugin data (사용자별 설정)
.obsidian/plugins/wikey/data.json
.obsidian/*.bak

# Claude Code session
.claude/settings.local.json
.claude/scheduled_tasks.lock
.venv-smoke/

# §5.6.6 spike scripts contain vendor OAuth client_id/secret (extracted from public
# CLI bundles, but blocked by GitHub secret scanning). Keep on disk for reference,
# exclude from git. SPIKE.md documents endpoint baseline + bundle source location.
docs/spikes/phase-5/5.6.6/poc-*.mjs
